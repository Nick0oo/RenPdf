{
  "name": "renpdf",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend -- --host 127.0.0.1",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:ui": "npm run test:ui --workspace frontend",
    "email:dev": "npm run dev --workspace emails",
    "email:export": "npm run export --workspace emails",
    "generate-client": "uv run --package app python scripts/export_openapi.py && npm run generate-client --workspace frontend && uv run --package app python scripts/normalize_client.py"
  },
  "overrides": {
    "katex": "^0.19.0",
    "next": "^16.3.8",
    "js-yaml": "^4.3.2"
  }
}
