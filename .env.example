PROJECT_NAME=RenPdf
FASTAPI_ENV=development
FRONTEND_HOST=http://localhost:5173
# Explicit development origin allowlist for the Vite proxy; keep empty in deployment.
FRONTEND_EXTRA_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
# Generate strong random values; configure_local.py replaces changethis locally.
SECRET_KEY=changethis
FIRST_SUPERUSER=owner@example.com
FIRST_SUPERUSER_PASSWORD=changethis
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_PORT=5433
REN_DATABASE_PASSWORD=replace_with_a_strong_application_database_password
DATABASE_URL=postgresql://postgres:replace_with_a_strong_database_password@127.0.0.1:5433/renpdf_chat
REDIS_URL=redis://127.0.0.1:6380/0
STORAGE_ROOT=../storage
# Environment-only credentials. GOOGLE_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY are also accepted.
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREADS=2
OLLAMA_NUM_GPU=0
LLAMACPP_BASE_URL=
LLAMACPP_MODE=unknown
LLAMACPP_MODEL_VERSION=
LLAMACPP_EMBEDDING_DIMENSIONS=768
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
PROVIDER_ALLOWED_HOSTS=["localhost","127.0.0.1","host.docker.internal","generativelanguage.googleapis.com"]
DEFAULT_CHAT_PROVIDER=gemini
# Select a real model from /providers. This field is not a model availability guarantee.
DEFAULT_CHAT_MODEL=
DEFAULT_EMBEDDING_PROVIDER=gemini
DEFAULT_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
# All extracted text chunks are queued for local embeddings when the selected
# embedding provider/model is local and configured. No cloud indexing is automatic.
AUTO_INDEX_LOCAL=true
MAX_MEDIA_DURATION_SECONDS=1800
MEDIA_SEGMENT_SECONDS=10
MAX_SPREADSHEET_SHEETS=50
MAX_SPREADSHEET_CELLS=200000
MAX_SPREADSHEET_GRID_CELLS=1000000
MAX_SPREADSHEET_ROWS=50000
MAX_SPREADSHEET_COLUMNS=512
MAX_SPREADSHEET_EXPANDED_MB=100
# FFmpeg and FFprobe are included in Docker; native runs require both on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLOUD_PROCESSING_DEFAULT_DENY=true
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=500
MAX_CONCURRENT_DOCUMENT_JOBS=1
ENABLE_OCR=true
ENABLE_VISION=false
PARSER_ENGINE=auto
# Native Docling requires no model weights; advanced docling requires local artifacts.
DOCLING_ARTIFACTS_PATH=
DOCLING_TOKENIZER_PATH=
PARSER_PAGE_TIMEOUT_SECONDS=90
PARSER_MEMORY_LIMIT_MB=1536
PARSER_RECYCLE_PAGES=8
OCR_LANGUAGE=eng+spa
RENDER_DPI=110
COOKIE_SECURE=false
ALLOW_PUBLIC_SIGNUP=false
EMBEDDINGGEMMA_BASE_URL=http://127.0.0.1:8082
DOCKER_EMBEDDINGGEMMA_BASE_URL=http://host.docker.internal:8082
